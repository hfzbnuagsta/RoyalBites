# Salin file ini menjadi ".env" lalu isi nilainya:   cp .env.example .env
# File ".env" berisi rahasia dan TIDAK boleh di-commit ke Git (sudah ada di .gitignore).
# Catatan: komentar ditulis di baris sendiri (bukan di belakang nilai) agar aman dibaca Docker/systemd.

# ---------------------------------------------------------------- Server
# "production" saat di-deploy
NODE_ENV=development
PORT=3000
# HOST default: 127.0.0.1 (development) / 0.0.0.0 (production)
# HOST=127.0.0.1

# Jika di belakang reverse proxy (Nginx, Caddy, Cloudflare, PaaS) isi dengan jumlah proxy, mis. 1.
# Wajib benar agar IP pengunjung (rate limit) dan HTTPS terbaca dengan benar. Kosongkan jika tanpa proxy.
TRUST_PROXY=
# Alihkan http -> https. Aktifkan di production jika proxy Anda tidak melakukannya sendiri.
FORCE_HTTPS=false

# Alamat resmi situs, mis. https://royalbites.example.com (tanpa slash di akhir).
# Dipakai untuk menolak request admin yang berasal dari situs lain. Boleh kosong jika admin dan situs satu domain.
APP_ORIGIN=
# Hanya isi jika halaman depan di-host di domain lain dari backend (pisahkan dengan koma). Kosong = satu domain.
CORS_ORIGINS=

# ---------------------------------------------------------------- Database MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=royalbites_app
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
DB_NAME=royal_bites
DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------- Sesi admin
# Masa berlaku maksimum satu login (jam)
SESSION_TTL_HOURS=8
# Logout otomatis jika tidak ada aktivitas (menit)
SESSION_IDLE_MINUTES=120
# Cookie "Secure" (hanya lewat HTTPS). Default: aktif jika NODE_ENV=production. Wajib aktif di production.
# COOKIE_SECURE=true
# Makin besar makin aman tetapi makin lambat (10-14 wajar)
BCRYPT_COST=12

# ---------------------------------------------------------------- Pembayaran QRIS (payment gateway)
# Biarkan PAYMENT_PROVIDER KOSONG jika belum punya akun gateway: opsi QRIS tidak akan ditampilkan sama sekali
# dan metode lama (tunai & transfer manual) tetap berjalan. Panduan lengkap: README bagian "Pembayaran QRIS".
#
#   (kosong)  = QRIS nonaktif
#   midtrans  = gateway Midtrans (sandbox untuk uji coba, production untuk uang sungguhan)
#   mock      = penyedia PALSU untuk development saja; kode QR-nya BUKAN QRIS sah. DITOLAK saat NODE_ENV=production.
PAYMENT_PROVIDER=
# Server Key dari dashboard Midtrans (Settings > Access Keys). RAHASIA: hanya di file .env server,
# jangan pernah di frontend/Git/chat. Kunci sandbox berawalan "SB-"; kunci production tanpa awalan itu.
PAYMENT_SERVER_KEY=
# false = sandbox (tanpa uang sungguhan). Ubah ke true HANYA setelah memakai kunci production dan lolos uji sandbox.
PAYMENT_IS_PRODUCTION=false
# Opsional (belum dipakai alur QRIS saat ini): Client Key dan Merchant ID dari dashboard Midtrans.
PAYMENT_CLIENT_KEY=
PAYMENT_MERCHANT_ID=
# URL notifikasi yang Anda daftarkan di dashboard Midtrans (Settings > Configuration > Payment Notification URL).
# Jika kosong, ditampilkan di dashboard admin sebagai APP_ORIGIN + /api/payments/midtrans/notification.
# Contoh: https://royalbites.example.com/api/payments/midtrans/notification  (wajib HTTPS untuk production)
PAYMENT_WEBHOOK_URL=
# Acquirer QRIS di Midtrans: gopay (default) atau airpay shopee, sesuai yang diaktifkan di akun Anda.
# Nilai ini diteruskan apa adanya ke Midtrans; pastikan sesuai dokumentasi/akun Anda.
PAYMENT_QRIS_ACQUIRER=gopay
# Batas waktu pelanggan membayar QRIS (menit, 5-1440)
PAYMENT_QRIS_EXPIRY_MINUTES=15
# Pesanan QRIS yang tidak dibayar dibatalkan otomatis (stok dikembalikan) setelah batas waktu + jeda ini (detik)
PAYMENT_EXPIRY_GRACE_SECONDS=90
# Seberapa sering server memeriksa pembayaran yang kedaluwarsa (detik)
PAYMENT_SWEEP_INTERVAL_SECONDS=60
# Konfirmasi ulang "lunas" ke API status gateway sebelum pesanan ditandai lunas (sangat disarankan: true)
PAYMENT_VERIFY_STATUS_API=true
# Batas waktu menunggu balasan gateway (milidetik)
PAYMENT_REQUEST_TIMEOUT_MS=10000
# PAYMENT_API_BASE_URL hanya untuk pengujian otomatis (server tiruan lokal) dan DITOLAK di production. Jangan diisi.

# ---------------------------------------------------------------- Lain-lain
# Folder gambar unggahan admin (ikut di-backup)
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=2
# Zona waktu bisnis untuk laporan: WIB=420, WITA=480, WIT=540
BUSINESS_UTC_OFFSET_MINUTES=420
# Percobaan login gagal yang diizinkan per 15 menit per IP
RATE_LIMIT_LOGIN_ATTEMPTS=10
# debug | info | warn | error | silent
LOG_LEVEL=info
